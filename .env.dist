# Timezone
TZ=UTC
#TZ=Europe/Berlin


# Optional S3
#GOKAPI_AWS_BUCKET=
#GOKAPI_AWS_REGION=
#GOKAPI_AWS_KEY=
#GOKAPI_AWS_KEY_SECRET=
#GOKAPI_AWS_ENDPOINT=


# ID Lengths
#GOKAPI_LENGTH_ID=15
#GOKAPI_LENGTH_HOTLINK_ID=40


# App Directories
#GOKAPI_CONFIG_DIR=config
#GOKAPI_CONFIG_FILE=config.json
#GOKAPI_DATA_DIR=data

# Chunk & Upload Config
#GOKAPI_CHUNK_SIZE_MB=45
#GOKAPI_MAX_FILESIZE=102400
#GOKAPI_MAX_MEMORY_UPLOAD=50
#GOKAPI_MAX_PARALLEL_UPLOADS=3
#TMPDIR=/app/data/tmp

# Expiry
# The furthest expiry allowed for an upload, e.g. "365d". 0 (default) allows permanent files
#GOKAPI_MAX_EXPIRY=0
# The expiry presets a client offers for a new upload
#GOKAPI_EXPIRY_OPTIONS=1d,7d,14d
# Which of those presets a client preselects for a new upload. Snapped down to the longest preset
# that does not exceed it and clamped to GOKAPI_MAX_EXPIRY. Must be positive; 0 does not mean
# unlimited here
#GOKAPI_DEFAULT_EXPIRY=1d
# How long a disposed file's metadata is kept as history, e.g. "12h" or "7d" (default). 0 removes
# the record together with its content
#GOKAPI_METADATA_RETENTION=7d
# How long a file request, its received files and its upload API key are kept once expired or
# closed, e.g. "12h" or "30d". 0 (default) disables this: nothing is removed just because a
# request expired or closed
#GOKAPI_FILEREQUEST_RETENTION=0
# How long the party who spent a download may retry or resume it, e.g. "30m". The spend mints a
# signed session token bound to that resource, and only a request carrying that token is served
# without spending another allowance - the plain link is dead for everyone, including them, the
# moment the allowance is spent. 0 (default) gives no window: every request spends an allowance
#GOKAPI_DOWNLOAD_SESSION_LEEWAY=0
# HMAC key for those session tokens, at least 32 characters. Required whenever the leeway above is
# greater than zero: the server refuses to start rather than sign with something weak
#GOKAPI_DOWNLOAD_SESSION_SIGN_KEY=


# Other flags
#GOKAPI_DISABLE_CORS_CHECK=false
#GOKAPI_LOG_STDOUT=false
#GOKAPI_ENABLE_HOTLINK_VIDEOS=false


# Outbound mail
# Connector: disabled (default), log, smtp, azure.
# "log" writes the message to the log instead of sending it, for development.
# An unknown value is a startup error, never a silent fallback to disabled.
#GOKAPI_MAIL_PROVIDER=disabled
#GOKAPI_MAIL_FROM=no-reply@example.com
#GOKAPI_MAIL_FROM_NAME=gojitech ExchangePoint
#GOKAPI_MAIL_TIMEOUT_SECONDS=20

# SMTP connector
#GOKAPI_MAIL_SMTP_HOST=smtp.example.com
#GOKAPI_MAIL_SMTP_PORT=587
#GOKAPI_MAIL_SMTP_USERNAME=
#GOKAPI_MAIL_SMTP_PASSWORD=
# starttls (default, port 587), tls (implicit, port 465), or none.
#GOKAPI_MAIL_SMTP_ENCRYPTION=starttls
# Permits an unencrypted connection and an unverified certificate. Required
# for ENCRYPTION=none. Refuses to combine with a username in ANY encryption
# mode, because an unverified certificate means the peer is not authenticated
# and a machine-in-the-middle could read the password. Local relays only.
#GOKAPI_MAIL_SMTP_ALLOW_INSECURE=false

# Azure Communication Services Email connector.
# Uses the REST API, not Azure's SMTP relay: the relay needs an Entra app
# registration and a <resource>.<app-id>.<tenant-id> username, whereas the
# connection string below is copied verbatim from the portal's Keys blade.
#GOKAPI_MAIL_AZURE_CONNECTION_STRING=endpoint=https://NAME.communication.azure.com/;accesskey=BASE64KEY
# Or supply the two halves separately instead of the connection string:
#GOKAPI_MAIL_AZURE_ENDPOINT=https://NAME.communication.azure.com
#GOKAPI_MAIL_AZURE_ACCESS_KEY=
